# Environment for `php artisan wallet:stress-test`. Copy to .env.stress (git-ignored).
APP_NAME="Wallet Transfer API (stress)"
APP_ENV=stress
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wallet_transfer_api
DB_USERNAME=wallet
DB_PASSWORD=

# File cache keeps rate-limiter rows out of MySQL, so lock-wait counts only reflect wallet locks.
CACHE_STORE=file
SESSION_DRIVER=array

# `php artisan serve --no-reload` starts this many PHP workers; one worker would serialize every request.
PHP_CLI_SERVER_WORKERS=24

# The scenario sends 20+ transfers per user per minute; the default limit of 10 would hide the race.
WALLET_TRANSFERS_PER_MINUTE=1000
